\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{myresume_modern}[2026/04/10 Modern research resume style]

\usepackage[a4paper,left=1.15cm,right=1.15cm,top=1.15cm,bottom=1.2cm]{geometry}
\usepackage{xcolor}
\usepackage{setspace}
\usepackage{fontspec}
\usepackage{tabularx}
\usepackage{ragged2e}
\usepackage{enumitem}
\usepackage{multicol}
\usepackage{array}

\definecolor{Accent}{HTML}{1A5266}
\definecolor{AccentSoft}{HTML}{E9F0F2}
\definecolor{TextPrimary}{HTML}{1E2630}
\definecolor{TextMuted}{HTML}{66707E}
\definecolor{RuleColor}{HTML}{DBE2E8}
\newcommand{\cvmark}{\textcolor{Accent}{\rule[0.32ex]{0.45ex}{0.45ex}}}

\setmainfont{SabonLTStd}[
    Path=./Fonts/Sabon/,
    Extension=.ttf,
    UprightFont=*-Regular,
    BoldFont=*-Bold,
    ItalicFont=*-Italic,
    BoldItalicFont=*-BoldItalic
]
\newfontfamily\Calluna{Calluna}[
    Path=./Fonts/Calluna/,
    Extension=.otf,
    UprightFont=*-Regular
]
\newfontfamily\Courier{CourierNew}[
    Path=./Fonts/Courier/,
    Extension=.ttf,
    UprightFont=*-Regular
]
\newfontfamily\CronosLt{CronosProLT}[
    Path=./Fonts/Cronos/,
    Extension=.ttf,
    UprightFont=*-Regular
]
\newfontfamily\HeadFont{Lato}[Path=./Fonts/Lato/,Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic]
\newfontfamily\HeadSemi{Lato}[Path=./Fonts/Lato/,Extension=.ttf,UprightFont=*-Semibold,ItalicFont=*-SemiboldItalic]
\newfontfamily\HeadMed{Lato}[Path=./Fonts/Lato/,Extension=.ttf,UprightFont=*-Medium]

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\multicolsep}{0pt}
\setlength{\columnsep}{0.55cm}
\linespread{0.98}

\renewcommand{\emph}[1]{\textbf{\color{Accent}#1}}

\newcommand{\ResumeName}[1]{{\HeadSemi\fontsize{27pt}{29pt}\selectfont\color{TextPrimary}#1}}
\newcommand{\ResumeRole}[1]{{\HeadMed\fontsize{10.5pt}{12.5pt}\selectfont\color{Accent}#1}}
\newcommand{\AccentRule}{\textcolor{RuleColor}{\rule{\textwidth}{0.8pt}}}

\newcommand{\SectionLabel}[1]{%
  \colorbox{AccentSoft}{%
    \parbox[c][0.86cm][c]{2.55cm}{%
      \centering{\HeadSemi\fontsize{9.6pt}{11pt}\selectfont\color{Accent}#1}%
    }%
  }%
}

\newcommand{\sectionBlock}[2]{%
  \noindent
  \begin{minipage}[t]{2.95cm}\vspace{0pt}\SectionLabel{#1}\end{minipage}
  \hfill
  \begin{minipage}[t]{14.2cm}\vspace{0pt}\raggedright #2\end{minipage}
  \vspace{10pt}
}

\newcommand{\cvEntry}[4]{%
  \begin{tabularx}{\linewidth}{@{}X>{\raggedleft\arraybackslash}p{3.25cm}@{}}
    {\textbf{\color{TextPrimary}#1}} & {\small\color{TextMuted}#2} \\
    {\textit{\small\color{TextMuted}#3}} & {\small\color{TextMuted}#4} \\
  \end{tabularx}
}

\newcommand{\projectEntry}[3]{%
  \begin{tabularx}{\linewidth}{@{}X>{\raggedleft\arraybackslash}p{3.25cm}@{}}
    {\textbf{\color{TextPrimary}#1}} & {\small\color{TextMuted}#3} \\
    \multicolumn{2}{@{}l@{}}{\textit{\small\color{TextMuted}#2}} \\
  \end{tabularx}
}

\newcommand{\itemListStart}{\begin{itemize}[leftmargin=1.25em,label=\cvmark,topsep=2pt,itemsep=3pt,parsep=0pt,partopsep=0pt]}
\newcommand{\itemListEnd}{\end{itemize}}
\newcommand{\myItem}[1]{\item \small #1}

\newcommand{\pubListStart}{\begin{itemize}[leftmargin=1.2em,label=\cvmark,topsep=2pt,itemsep=2.3pt,parsep=0pt,partopsep=0pt]}
\newcommand{\pubListEnd}{\end{itemize}}

\newcommand{\awardListStart}{\begin{itemize}[leftmargin=1.15em,label=\cvmark,topsep=1pt,itemsep=1.5pt,parsep=0pt,partopsep=0pt]}
\newcommand{\awardListEnd}{\end{itemize}}

\newcommand{\skillListStart}{\begin{itemize}[leftmargin=0pt,label={},topsep=0pt,itemsep=1.6pt,parsep=0pt,partopsep=0pt]}
\newcommand{\skillListEnd}{\end{itemize}}
