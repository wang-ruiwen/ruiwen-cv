\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{myresume_refined}[2026/04/17 Refined original resume style]

% Page size
\usepackage[a4paper,top=1.1cm,bottom=1.15cm,left=1.35cm,right=1.35cm]{geometry}

% Packages
\usepackage{xcolor}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{tabularx}
\usepackage{ragged2e}
\usepackage{fontspec}
\usepackage{multicol}

% Colors
\definecolor{Accent}{HTML}{1A3B57}
\definecolor{RuleColor}{HTML}{CFD9E2}

% Font style
\setmainfont{SabonLTStd}[
    Path=./Fonts/Sabon/,
    Extension=.ttf,
    UprightFont=*-Regular,
    BoldFont=*-Bold,
    ItalicFont=*-Italic,
    BoldItalicFont=*-BoldItalic
]
\newfontfamily\Calluna{Calluna}[
    Path=./Fonts/Calluna/,
    Extension=.otf,
    UprightFont=*-Regular
]
\newfontfamily\Courier{CourierNew}[
    Path=./Fonts/Courier/,
    Extension=.ttf,
    UprightFont=*-Regular
]
\newfontfamily\CronosLt{CronosProLT}[
    Path=./Fonts/Cronos/,
    Extension=.ttf,
    UprightFont=*-Regular
]

% Emph style
\renewcommand{\emph}[1]{\textbf{\color{Accent}\fontsize{10.8pt}{10.8pt}\selectfont #1}}

% Section block
\newcommand{\sectionBlock}[2]{%
    \noindent
    \begin{minipage}[t]{2.55cm}
    \raggedright
    #1
    \end{minipage}
    \hfill
    \begin{minipage}[t]{14.2cm}
    \raggedright
    #2
    \end{minipage}
    \vspace{11pt}
}

% Section title
\titleformat{\section}{
  \setstretch{1.0}
  \CronosLt\scshape\raggedright\color{Accent}
  \fontsize{13.6pt}{13.6pt}\selectfont
}{}{0em}{}

% Lists
\newcommand{\pubListStart}{\begin{itemize}[leftmargin=1.15em,label=\textbullet,topsep=1.2pt,itemsep=1.2pt,parsep=0pt,partopsep=0pt]}
\newcommand{\pubListEnd}{\end{itemize}\vspace{-6pt}}

\newcommand{\awardListStart}{\begin{itemize}[leftmargin=1.05em,label=\textbullet,topsep=1pt,itemsep=1pt,parsep=0pt,partopsep=0pt]}
\newcommand{\awardListEnd}{\end{itemize}\vspace{-6pt}}

\newcommand{\skillListStart}{\begin{itemize}[leftmargin=0pt,label={},topsep=0pt,itemsep=0.8pt,parsep=0pt,partopsep=0pt]}
\newcommand{\skillListEnd}{\end{itemize}\vspace{-6pt}}

\newcommand{\itemListStart}{\begin{itemize}[leftmargin=1.15em,label=\textbullet,topsep=1.4pt,itemsep=1.6pt,parsep=0pt,partopsep=0pt]}
\newcommand{\itemListEnd}{\end{itemize}\vspace{-4pt}}
\newcommand{\myItem}[1]{\item {#1}}

% Education information
\newcommand{\eduHeading}[4]{
  \renewcommand{\arraystretch}{1.12}
    \begin{tabular}[t]{p{14.08cm}}
      \emph{#1} \hfill #2 \\
      \textit{#3} \hfill #4 \\
    \end{tabular}\vspace{-5pt}
}

% Project information
\newcommand{\projHeading}[3]{
  \renewcommand{\arraystretch}{1.1}
    \begin{tabular}[t]{p{14.08cm}}
      \textbf{#1} \hfill \\
      \textit{#2} \hfill #3 \\
    \end{tabular}\vspace{2pt}
}
